@using GymManagementSystem.BLL.ViewModels.BookingViewModels
@model IEnumerable<MemberForSessionViewModel>

@{
    ViewData["Title"] = "Session Booking Details";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show mt-4">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show mt-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1 fw-semibold">Session Members (Upcoming)</h2>
            <p class="mb-0 text-light opacity-75">Members That Already Booked This Session</p>
        </div>
        <div class="text-end">
            <a asp-action="Create"
               asp-route-id="@ViewContext.RouteData.Values["id"]"
               class="btn btn-light fw-semibold">
                <i class="fas fa-plus me-1"></i> New Booking
            </a>
        </div>
    </div>
</header>

<div class="card shadow-sm">
    <div class="card-body">

        @if (Model != null && Model.Any())
        {
            <table class="table table-striped table-hover align-middle text-center">
                <thead>
                    <tr>
                        <th>Member Name</th>
                        <th>Booking Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.MemberName</td>
                            <td class="text-muted">@item.BookingDate</td>
                            <td>
                                <div class="d-flex justify-content-center gap-1">
                                    <form method="post" asp-action="Cancel" class="m-0">
                                        <input type="hidden" name="memberId" value="@item.MemberId" />
                                        <input type="hidden" name="sessionId" value="@item.SessionId" />

                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to cancel this booking?');">
                                            <i class="fas fa-times me-1"></i> Cancel Booking
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-plus display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">No Bookings Available for this Session</h4>
                <p class="text-muted mb-0">Click "New Booking" above to add members to this session.</p>
            </div>
        }
    </div>

    <div class="card-footer bg-white">
        <a asp-controller="Bookings" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Sessions List
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertBoxScript.cshtml" />
}