@model IEnumerable<MemberForSessionViewModel>

@{
    ViewData["Title"] = "Session Attendance";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show mt-4">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show mt-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<header class="bg-success text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1 fw-semibold">Session Members (Ongoing)</h2>
            <p class="mb-0 text-light opacity-75">Manage Members Attendance</p>
        </div>
    </div>
</header>

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <table class="table table-striped table-hover align-middle text-center">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Attendance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.MemberName</td>
                            <td>
                                <div class="d-flex justify-content-center gap-1">
                                    @if (item.IsAttended)
                                    {
                                        <span class="text-success fw-bold">
                                            <i class="bi bi-check-circle-fill me-1"></i> Attended
                                        </span>
                                    }
                                    else
                                    {
                                        <form asp-action="Attended" method="post" class="d-inline">
                                           
                                            <input type="hidden" name="memberId" value="@item.MemberId" />
                                            <input type="hidden" name="sessionId" value="@item.SessionId" />

                                            <button type="submit" class="btn btn-outline-success btn-sm">
                                                <i class="bi bi-check-circle me-1"></i> Mark as Attended
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-people display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">No Members Booked for this Session</h4>
            </div>
        }
    </div>

    <div class="card-footer bg-white d-flex justify-content-between">
      
        <a asp-controller="Bookings" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertBoxScript.cshtml" />
}