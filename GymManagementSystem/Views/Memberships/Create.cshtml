@model CreateMemberShipViewModel

@{
    ViewData["Title"] = "Create Membership";
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show mt-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="MemberId" class="form-label fw-semibold">Member</label>
                            <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                                <option value="">-- Select Member --</option>
                            </select>
                            <span asp-validation-for="MemberId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PlanId" class="form-label fw-semibold">Plan</label>
                            <select asp-for="PlanId" asp-items="ViewBag.Plans" class="form-select">
                                <option value="">-- Select Plan --</option>
                            </select>
                            <span asp-validation-for="PlanId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="StartDate" class="form-label fw-semibold">Start Date (Optional)</label>
                            <input asp-for="StartDate" type="date" class="form-select" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Create Membership
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertBoxScript.cshtml" />

    <script>
        $(document).ready(function () {

            var alertBox = $("#Alert");

            if (alertBox.length > 0) {

                setTimeout(function () {
                    alertBox.fadeOut(1000, function () {
                        $(this).remove();
                    });
                }, 3000);
            }
        });
    </script>
}